    "typescript",
    "react",
    "starter"
  ],
  "main": "src/index.tsx",
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "express": "^4.19.2",
    "loader-utils": "3.2.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-redux": "^9.1.2",
    "react-scripts": "5.0.1",
    "redux-saga": "^1.3.0"
  },
  "devDependencies": {
    "@types/react": "18.2.38",
    "@types/react-dom": "18.2.15",
    "typescript": "4.4.4",
    "@types/express": "^4.17.21",
    "concurrently": "^8.2.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "server": "node server/index.js",
